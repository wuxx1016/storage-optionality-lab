.symbol-grid > div { border-bottom: 1px solid var(--line); grid-template-co=
lumns: 70px 1fr; gap: 12px; padding: 14px 10px 14px 0px; display: grid; }

.symbol-grid > div:nth-child(2n+1) { border-right: 1px solid var(--line); }

.symbol-grid > div:nth-child(2n) { padding-left: 18px; }

.symbol-grid code { color: var(--blue); font-family: var(--font-mono), mono=
space; font-size: 13px; font-weight: 700; }

.symbol-grid span { color: var(--muted); font-size: 12px; line-height: 1.45=
; }

.data-figure { border: 1px solid var(--line); background: rgb(255, 255, 255=
); border-radius: 6px; margin: 40px 0px; padding: 14px; }

.data-figure img { width: 100%; height: auto; display: block; }

.lab-section { background: linear-gradient(rgba(0, 0, 0, 0), rgba(244, 247,=
 245, 0.55) 22%, rgba(0, 0, 0, 0)); }

.metric-strip { background: var(--line); border: 1px solid var(--line); gri=
d-template-columns: repeat(4, 1fr); gap: 1px; margin: 30px 0px 36px; displa=
y: grid; }

.metric-strip > div { background: rgb(255, 255, 255); min-width: 0px; paddi=
ng: 18px 16px; }

.metric-strip span { color: var(--muted); font-family: var(--font-mono), mo=
nospace; text-transform: uppercase; font-size: 10px; font-weight: 700; disp=
lay: block; }

.metric-strip strong { color: var(--ink); margin: 8px 0px 4px; font-size: 2=
0px; line-height: 1.15; display: block; }

.metric-strip small { color: var(--blue); font-size: 11px; }

.lab-grid.two { grid-template-columns: 1fr 1fr; align-items: start; gap: 20=
px; margin: 26px 0px; display: grid; }

.lab-grid .data-figure { margin: 0px; }

.lab-figure figcaption { min-height: 34px; }

.insight-list { background: var(--line); border: 1px solid var(--line); gri=
d-template-columns: repeat(3, 1fr); gap: 1px; margin: 34px 0px; display: gr=
id; }

.insight-list > div { background: var(--blue-soft); padding: 20px; }

.insight-list span { color: var(--blue); font-family: var(--font-mono), mon=
ospace; text-transform: uppercase; font-size: 10px; font-weight: 800; }

.insight-list p { color: rgb(75, 93, 101); margin: 8px 0px 0px; font-size: =
13px; line-height: 1.65; }

.two-column-note { background: var(--line); border: 1px solid var(--line); =
grid-template-columns: 1fr 1fr; gap: 1px; margin: 32px 0px; display: grid; =
}

.two-column-note > div { background: var(--blue-soft); padding: 22px; }

.two-column-note p { color: rgb(75, 93, 101); margin: 0px; font-size: 13px;=
 }

.formula-list { border-top: 1px solid var(--line); margin: 26px 0px; }

.formula-list > div { border-bottom: 1px solid var(--line); grid-template-c=
olumns: 150px 1fr; align-items: center; gap: 24px; padding: 17px 0px; displ=
ay: grid; }

.formula-list > div > span { color: var(--muted); font-size: 12px; font-wei=
ght: 700; }

.method-steps { margin: 24px 0px; }

.method-steps > div { border-top: 1px solid var(--line); grid-template-colu=
mns: 44px 1fr; gap: 10px; padding: 16px 0px; display: grid; }

.method-steps > div:last-child { border-bottom: 1px solid var(--line); }

.method-steps span, .planned-plots span { color: var(--green); font-family:=
 var(--font-mono), monospace; font-size: 11px; }

.method-steps p { margin: 0px; font-size: 13px; }

.driver-table, .comparison-table { border-top: 2px solid var(--ink); margin=
: 30px 0px; }

.driver-table > div, .comparison-table > div { border-bottom: 1px solid var=
(--line); grid-template-columns: 1.05fr 1.05fr 1.4fr; gap: 18px; padding: 1=
4px 8px; font-size: 12px; line-height: 1.5; display: grid; }

.driver-head, .comparison-head { color: var(--muted); font-family: var(--fo=
nt-mono), monospace; text-transform: uppercase; font-weight: 700; font-size=
: 10px !important; }

.driver-table strong, .comparison-table strong { color: var(--green); }

.comparison-table > div { grid-template-columns: 0.8fr 1.15fr 1.6fr; }

.planned-plots { background: var(--ink); color: rgb(255, 255, 255); border-=
radius: 6px; margin: 38px 0px 0px; padding: 28px; }

.planned-plots h3 { margin-top: 0px; }

.planned-plots > div { border-top: 1px solid rgba(255, 255, 255, 0.15); gri=
d-template-columns: 36px 1fr; gap: 8px; padding: 12px 0px; display: grid; }

.planned-plots span { color: rgb(127, 208, 176); }

.planned-plots p { color: rgb(218, 227, 223); margin: 0px; font-size: 13px;=
 }

.roadmap-section { border-bottom: 0px; }

.roadmap { margin: 42px 0px 0px; padding: 0px; list-style: none; }

.roadmap li { border-top: 1px solid var(--line); grid-template-columns: 90p=
x 1fr; gap: 22px; padding: 26px 0px; display: grid; }

.roadmap li:last-child { border-bottom: 1px solid var(--line); }

.roadmap > li > span { color: var(--green); font-family: var(--font-mono), =
monospace; text-transform: uppercase; font-size: 11px; font-weight: 700; }

.roadmap h3 { margin: 0px 0px 7px; }

.roadmap p { margin: 0px 0px 8px; font-size: 13px; }

.roadmap small { color: var(--blue); font-size: 11px; line-height: 1.55; }

.references-section { padding-top: 46px; }

.references { margin: 0px; padding: 0px; list-style: none; }

.references li { border-top: 1px solid var(--line); grid-template-columns: =
38px 1fr; gap: 14px; padding: 14px 0px; display: grid; }

.references li:last-child { border-bottom: 1px solid var(--line); }

.references > li > span { color: var(--muted); font-family: var(--font-mono=
), monospace; font-size: 10px; }

.references p { margin: 0px; font-size: 12px; }

.references a { color: var(--green); font-weight: 700; }

.references a svg { vertical-align: -2px; display: inline; }

.status-rail { gap: 14px; display: grid; }

.status-block { border: 1px solid var(--line); border-radius: 6px; padding:=
 16px; }

.status-block p:not(.status-title) { color: var(--muted); margin: 12px 0px =
0px; font-size: 10px; line-height: 1.55; }

.status-dot { border: 1px solid var(--line-dark); border-radius: 50%; width=
: 7px; height: 7px; margin-right: 7px; display: inline-block; }

.status-dot.current { background: var(--green); border-color: var(--green);=
 }

.status-note { background: var(--blue-soft); }

footer { background: var(--ink); color: rgb(255, 255, 255); justify-content=
: space-between; align-items: center; min-height: 170px; padding: 40px max(=
32px, 50% - 560px); display: flex; }

footer > div { gap: 14px; }

footer p { margin: 0px; font-size: 12px; font-weight: 700; line-height: 1.4=
5; }

footer small { color: rgb(174, 187, 181); font-weight: 400; }

footer a { color: rgb(199, 212, 206); gap: 6px; font-size: 11px; }

@media (width <=3D 1180px) {
  .article-grid { grid-template-columns: 160px minmax(0px, 820px); justify-=
content: center; gap: 38px; }
  .status-rail { display: none; }
}

@media (width <=3D 820px) {
  .topbar { height: 58px; padding: 0px 18px; }
  .toplinks > a:first-child { display: none; }
  .hero { background-size: 72px 72px; min-height: 560px; }
  .hero-inner { width: calc(100% - 36px); padding: 48px 0px; }
  h1 { font-size: 52px; }
  .hero-copy { font-size: 17px; }
  .article-grid { width: calc(100% - 36px); display: block; }
  .toc { display: none; }
  .paper-section { padding: 68px 0px; }
  .section-heading h2 { font-size: 38px; }
  .section-lede { font-size: 16px; }
  .equation-shell { margin: 22px -8px; padding: 17px 10px 13px; }
  .equation-scroll .katex { font-size: 1em; }
  .definition-row { grid-template-columns: 1fr; gap: 7px; }
  .symbol-grid, .two-column-note { grid-template-columns: 1fr; }
  .symbol-grid > div:nth-child(2n+1) { border-right: 0px; }
  .symbol-grid > div:nth-child(2n) { padding-left: 0px; }
  .metric-strip, .lab-grid.two, .insight-list { grid-template-columns: 1fr;=
 }
  .metric-strip strong { font-size: 18px; }
  .driver-table > div, .comparison-table > div { grid-template-columns: 1fr=
; gap: 5px; padding: 17px 8px; }
  .driver-head, .comparison-head { display: none !important; }
  .roadmap li { grid-template-columns: 1fr; gap: 8px; }
  footer { flex-direction: column; align-items: flex-start; gap: 30px; padd=
ing: 36px 18px; }
}

@media (width <=3D 500px) {
  .wordmark > span:last-child { display: none; }
  .toplinks { gap: 16px; }
  h1 { font-size: 45px; }
  .hero-meta { flex-direction: column; align-items: flex-start; }
  .section-heading h2 { font-size: 34px; }
  .formula-list > div { grid-template-columns: 1fr; gap: 8px; }
  .planned-plots { margin-left: -8px; margin-right: -8px; padding: 22px 18p=
x; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
}
